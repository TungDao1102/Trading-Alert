# Keeps secrets, state and non-runtime files out of the build context (T-13.1-10).
# Anything in the context can end up in an image layer, so secrets are excluded here and
# reach containers only at runtime through env_file.

# Secrets: .env and every variant except the committed template.
.env
.env.*
!.env.example

# Version control and local tooling state
.git
.gitattributes
.github
.codegraph
.gsd
.omo
.planning
.claude

# Local environments and caches
.venv
.pytest_cache
.mypy_cache
.ruff_cache
__pycache__
*.py[cod]

# Runtime data and backups live in named volumes, never in the image
data
logs
backup

# Tests are not part of the runtime image
tests
