# Trading-Alert BACKUP-service environment template (plan 24-36, D-29, WR-06, OPS-02)
#
# Copy to `.env.backup` (or the file named by TRADING_BACKUP_ENV_FILE) and fill in real values.
# `.env.backup` is ignored by version control and must stay mode 0600. Never commit a value, never
# paste one into a chat, a log or a shell history, never read it back into a transcript
# (src/ops/redaction.py).
#
# This file is read ONLY by the `backup` and `ops` compose services (profile `ops`), on top of the
# shared `.env` (database values), and by deploy/backup.sh (it reads BACKUP_REMOTE and
# BACKUP_S3_BUCKET from it for its own checks). The always-on collector, db-upgrade, paper and live
# services do not read it, so the backup crypt key and the S3 key never reach an internet-facing
# process.
#
# The soak (deploy/compose-soak.sh and the trading-soak-backup unit) points TRADING_BACKUP_ENV_FILE
# at its soak env file, whose BACKUP_S3_BUCKET must be a bucket of its own.

# --- Off-host backup target (D-12 hard requirement) ---
# Phase 2: OneDrive-synced dir is the documented fallback (RESEARCH §Open Q2).
# Harden to a true second host in a later phase.
# Canonical default is data/backup — matches DEFAULT_BUNDLE_ROOT in
# src/ops/backup.py, the compose backupdata mount (/app/data/backup),
# and scripts/backup-drill.ps1.
OFF_HOST_BACKUP_TARGET=data/backup

# --- Backups (D-12/D-17) ---
# Off-host, client-side encrypted backup target (rclone S3 remote + crypt).
# BACKUP_S3_PROVIDER: AWS, Wasabi, or Other (Other = Backblaze B2 S3 endpoint
# and any other S3-compatible store; then set BACKUP_S3_ENDPOINT).
# BACKUP_REMOTE: empty (or s3) = the off-host remote below (default; a missing
# BACKUP_S3_ name fails closed). none = explicit local-only mode (RUNBOOK 11):
# no remote at all, a loud "OFF-HOST COPY SKIPPED" warning and the marker line
# "OFFSITE_COPY=skipped"; the backup does not survive the loss of this host.
BACKUP_REMOTE=
BACKUP_S3_PROVIDER=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_CRYPT_PASSWORD and BACKUP_CRYPT_PASSWORD2 must be `rclone obscure`
# output (rclone rejects a raw passphrase), not the passphrase itself. The RAW
# passphrase (and salt) is kept off the VPS, in your password manager and a
# second offline copy. Losing it makes every backup unrecoverable: the bucket
# will look empty or garbled, with no way back.
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_PASSWORD2=
