# Trading-Alert environment template
#
# Copy to `.env` and fill in real values; `.env` is gitignored. Never commit
# credentials. Per D-05 / T-02-02, PG credentials come from env only.
#
# On the VPS the real `.env` is created by deploy/bootstrap.sh with mode 0600
# from an off-host secrets file; it is never typed into a shell history, never
# baked into an image and never read back into logs (src/ops/redaction.py).
#
# Reference: docs/integration/BINANCE.md §1 (no API keys needed for public
# market-data endpoints in Phase 2 — klines, exchangeInfo, openInterest,
# fundingRate, openInterestHist). Phase 9 live execution will add signed
# endpoints here.

# --- PostgreSQL 17 (operational state — metadata, watermarks, gaps) ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me_in_local_env_only
POSTGRES_DB=trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async-engine URL consumed by src/db/alembic/env.py and SQLAlchemy session.
# `+psycopg` (sync) is what alembic uses; the async engine swaps to
# `postgresql+psycopg://...` automatically (src/db/models.py make_engine).
DATABASE_URL=postgresql+psycopg://trading:change_me_in_local_env_only@localhost:5432/trading

# --- Collector cadence (D-07 — 5 min baseline for OI) ---
OI_POLL_INTERVAL_SECONDS=300

# --- Off-host backup target (D-12 hard requirement) ---
# Phase 2: OneDrive-synced dir is the documented fallback (RESEARCH §Open Q2).
# Harden to a true second host in a later phase.
# Canonical default is data/backup — matches DEFAULT_BUNDLE_ROOT in
# src/ops/backup.py, the compose backupdata mount (/app/data/backup),
# and scripts/backup-drill.ps1.
OFF_HOST_BACKUP_TARGET=data/backup

# --- Phase 7 paper soak (PAPER-03) — operator-provisioned, off-source only ---
# These three vars are required by the pre-soak smoke (see
# .planning/phases/07-paper-forward-observation/07-USER-SETUP.md).
# NEVER commit real values; the .env file is gitignored. The lines below
# are commented placeholders documenting the variable name, source, and
# shape only — copy each line into your local .env and fill in the value.
#
# TELEGRAM_BOT_TOKEN
#   source: Telegram BotFather-issued token (https://t.me/BotFather)
#   shape:  <digits>:<alnum>   (e.g. 123456789:AAH... — never paste here)
#   used by: src/adapters/telegram_notify.py (send_simulate)
#
# TELEGRAM_AUTHORIZED_CHAT_ID
#   source: operator-provisioned allowlisted chat id receiving SIMULATE
#           messages; discover via `curl
#           https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/getUpdates`
#   shape:  integer (positive, may be negative for groups)
#   used by: src/paper/notify.py (notify_simulate)
#
# PAPER_DATABASE_URL
#   source: operator-provisioned postgresql+psycopg URL for the soak
#           database (Compose PostgreSQL 17)
#   shape:  postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
#   used by: src/db/alembic/env.py + SQLAlchemy session for paper journal
#             rows (SignalRow, TradePlanRow, ApprovalRow, JournalEventRow)
#   note:    Alembic 0001_baseline + 0002_domain_registry must be applied
#             before the soak starts (`uv run alembic upgrade head`).

# --- Paper/test exchange credentials (Phase 18 consumer) ---
# Binance futures TESTNET key pair only. These names are deliberately different
# from the live names below (OPS-06): a paper process can never pick up a live
# credential by accident, and vice versa.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Live exchange credentials (Phase 24; keep commented until then) ---
# No-withdrawal key, IP allow-listed to the VPS public IP (OPS-02). Uncomment
# only in the live deployment's own .env, never in the paper/test one.
# BINANCE_LIVE_API_KEY=
# BINANCE_LIVE_API_SECRET=

# --- Backups (D-12/D-17) ---
# Off-host, client-side encrypted backup target (rclone S3 remote + crypt).
# BACKUP_S3_PROVIDER: AWS, Wasabi, or Other (Other = Backblaze B2 S3 endpoint
# and any other S3-compatible store; then set BACKUP_S3_ENDPOINT).
BACKUP_S3_PROVIDER=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_CRYPT_PASSWORD and BACKUP_CRYPT_PASSWORD2 must be `rclone obscure`
# output (rclone rejects a raw passphrase), not the passphrase itself. The RAW
# passphrase (and salt) is kept off the VPS, in your password manager and a
# second offline copy. Losing it makes every backup unrecoverable: the bucket
# will look empty or garbled, with no way back.
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_PASSWORD2=

# --- Image selection (compose) ---
# Tag of the trading-alert image the stack runs; CI and deploys pin a release.
IMAGE_TAG=dev
