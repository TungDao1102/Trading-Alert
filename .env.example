# Trading-Alert environment template
#
# Copy to `.env` and fill in real values; `.env` is gitignored. Never commit
# credentials. Per D-05 / T-02-02, PG credentials come from env only.
#
# Reference: docs/integration/BINANCE.md §1 (no API keys needed for public
# market-data endpoints in Phase 2 — klines, exchangeInfo, openInterest,
# fundingRate, openInterestHist). Phase 9 live execution will add signed
# endpoints here.

# --- PostgreSQL 17 (operational state — metadata, watermarks, gaps) ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me_in_local_env_only
POSTGRES_DB=trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async-engine URL consumed by src/db/alembic/env.py and SQLAlchemy session.
# `+psycopg` (sync) is what alembic uses; the async engine swaps to
# `postgresql+psycopg://...` automatically (src/db/models.py make_engine).
DATABASE_URL=postgresql+psycopg://trading:change_me_in_local_env_only@localhost:5432/trading

# --- Collector cadence (D-07 — 5 min baseline for OI) ---
OI_POLL_INTERVAL_SECONDS=300

# --- Off-host backup target (D-12 hard requirement) ---
# Phase 2: OneDrive-synced dir is the documented fallback (RESEARCH §Open Q2).
# Harden to a true second host in a later phase.
# Canonical default is data/backup — matches DEFAULT_BUNDLE_ROOT in
# src/ops/backup.py, the compose backupdata mount (/app/data/backup),
# and scripts/backup-drill.ps1.
OFF_HOST_BACKUP_TARGET=data/backup
