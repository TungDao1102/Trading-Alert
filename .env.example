# Trading-Alert environment template
#
# Copy to `.env` and fill in real values; `.env` is gitignored. Never commit
# credentials. Per D-05 / T-02-02, PG credentials come from env only.
#
# On the VPS the real `.env` is created by deploy/bootstrap.sh with mode 0600
# from an off-host secrets file; it is never typed into a shell history, never
# baked into an image and never read back into logs (src/ops/redaction.py).
#
# Reference: docs/integration/BINANCE.md §1 (no API keys needed for public
# market-data endpoints in Phase 2 — klines, exchangeInfo, openInterest,
# fundingRate, openInterestHist). Phase 9 live execution will add signed
# endpoints here (they go in `.env.live`, never in this file).

# --- PostgreSQL 17 (operational state — metadata, watermarks, gaps) ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_me_in_local_env_only
POSTGRES_DB=trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async-engine URL consumed by src/db/alembic/env.py and SQLAlchemy session.
# `+psycopg` (sync) is what alembic uses; the async engine swaps to
# `postgresql+psycopg://...` automatically (src/db/models.py make_engine).
DATABASE_URL=postgresql+psycopg://trading:change_me_in_local_env_only@localhost:5432/trading

# --- Collector cadence (D-07 — 5 min baseline for OI) ---
OI_POLL_INTERVAL_SECONDS=300

# --- Per-service names are NOT in this file (plans 24-30 and 24-36, D-29, WR-06) ---
# This shared file holds only the database values, the collector cadence and the image tag. It is
# read by every compose service, so a secret here would reach the internet-facing collector. The
# rest lives in one file per service group, each with a names-only template:
#   `.env.live`    (`.env.live.example`)    the `live` service only: Binance DEMO and LIVE key names,
#                  the live Telegram bot names, LIVE_RUNTIME_MODE. TRADING_LIVE_ENV_FILE selects it.
#   `.env.paper`   (`.env.paper.example`)   the `paper` and `paper-pin` services only: the SHADOW
#                  Telegram names (TELEGRAM_BOT_TOKEN, TELEGRAM_AUTHORIZED_CHAT_ID,
#                  TELEGRAM_AUTHORIZED_USER_IDS). TRADING_PAPER_ENV_FILE selects it.
#   `.env.backup`  (`.env.backup.example`)  the `backup` and `ops` services (profile `ops`) and
#                  deploy/backup.sh: every BACKUP_ name and OFF_HOST_BACKUP_TARGET.
#                  TRADING_BACKUP_ENV_FILE selects it.
# Each real file is mode 0600 and ignored by version control. The three selector variables are
# read by compose only and are described in docs/operations/RUNBOOK.md (they are not set here).
# The paper runtime refuses to start when a `BINANCE_` name is present, and the per-service lists
# in tests/test_live_compose_env_split.py keep every name out of the services that must not hold it.

# --- Image selection (compose) ---
# Tag of the trading-alert image the stack runs; CI and deploys pin a release.
IMAGE_TAG=dev
# Build-time revision stamp (OPS-04): the 40 character commit the image is built from, passed to
# the Dockerfile as a build argument. deploy/update.sh and deploy/soak-image.sh export it for you;
# leave it unset here (an unstamped image reports "unknown"). Set it only for a hand-run
# `docker compose build`, from `git rev-parse HEAD`.
# TRADING_APP_REVISION=

# --- Running the full test suite (developer machines) ---
# IMPORTANT: pytest reads these from the PROCESS ENVIRONMENT only. tests/pg_support.py
# does not load .env, so exporting them here has no effect; set them in the shell
# that runs scripts/dev/test.ps1 or `uv run pytest`, e.g. in PowerShell:
#   $env:TEST_DATABASE_URL = "postgresql+psycopg://trading:<POSTGRES_PASSWORD>@localhost:5432/trading_test"
# Without it every *_pg.py test (about 400) is skipped.
#
# TEST_DATABASE_URL
#   source: the Compose PostgreSQL 17 (`docker compose up -d postgres`, published on
#           127.0.0.1:${POSTGRES_PORT}) or any local server; reuse POSTGRES_USER/PASSWORD
#   shape:  postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
#   rules:  point it at a throwaway database whose name ends in `_test` (never the
#           operational `trading` one). The user needs CREATEDB: tests create and drop
#           disposable `t17_<hex>_test` databases on that server.
# TEST_DATABASE_URL=postgresql+psycopg://trading:change_me_in_local_env_only@localhost:5432/trading_test
#
# TRADING_CI_STRICT=1 (optional) turns every "missing infrastructure" skip into a
# failure, exactly as CI does. Leave unset locally unless you want that.
# TRADING_CI_STRICT=1
#
# Optional prerequisites; their tests skip when absent:
#   shellcheck        winget install koalaman.shellcheck (restart the terminal)
#   docker images     docker compose --profile ops build   (trading-alert:dev, trading-alert-ops:dev)
#   rclone image      docker pull the digest pinned in tests/test_docker_backup_remote.py
#   bash (Windows)    Git for Windows; the WSL launcher in System32/WindowsApps is ignored
