# Trading-Alert LIVE-service environment template (plan 24-30, D-29, WR-06, OPS-02)
#
# Copy to `.env.live` (or the file named by TRADING_LIVE_ENV_FILE) and fill in real values.
# `.env.live` is gitignored and must stay mode 0600. Never commit a value, never paste one into a
# chat, a log or a shell history, never read it back into a transcript (src/ops/redaction.py).
#
# This file is read ONLY by the `live` compose service (docker-compose.yml, env_file of `live`).
# The shared `.env` is NOT read by that service, and this file is not read by the collector,
# db-upgrade, paper or backup services: the Binance names and the live bot names below therefore
# reach the live container alone. The paper runtime also refuses to start when any BINANCE_ name
# is present in its environment (second barrier), so never copy these lines into `.env`.
# The database values (DATABASE_URL, POSTGRES_HOST) are set by compose itself, not here.
#
# The live process refuses to start when the credential names of the OTHER mode are present, even
# with an empty value, and when the shadow bot variable TELEGRAM_BOT_TOKEN is present. Keep one
# mode's key pair active and the other commented.

# --- Mode (24-01 D-02): exactly DEMO or LIVE, never inferred from a URL ---
# LIVE is refused while live placement is disabled (LIVE_ORDERS_DISABLED, the default).
LIVE_RUNTIME_MODE=DEMO

# --- Binance futures DEMO Trading key pair (mode DEMO) ---
# Ratified names (O-18-01). Deliberately different from the live names below (OPS-06).
# Alternative: BINANCE_DEMO_API_KEY_FILE / BINANCE_DEMO_API_SECRET_FILE name an absolute path to
# a file outside the checkout that holds the value.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# --- Binance futures LIVE key pair (mode LIVE; keep commented until the owner enables LIVE) ---
# No-withdrawal key, IP allow-listed to the VPS public IP (OPS-02). Comment the DEMO pair above
# when you uncomment these, so only one mode's names are present.
# BINANCE_LIVE_API_KEY=
# BINANCE_LIVE_API_SECRET=

# --- Live Telegram identity (24-01 Q6): its own bot, the same owner chat and users ---
# TELEGRAM_LIVE_BOT_TOKEN
#   source: a SECOND bot from BotFather, not the shadow bot of the paper runtime (one getUpdates
#           consumer per bot token)
# TELEGRAM_LIVE_AUTHORIZED_CHAT_ID
#   shape:  a positive integer (a private chat with the owner)
# TELEGRAM_AUTHORIZED_USER_IDS
#   shape:  comma-separated positive integers, the same owner ids the paper runtime allows
TELEGRAM_LIVE_BOT_TOKEN=
TELEGRAM_LIVE_AUTHORIZED_CHAT_ID=
TELEGRAM_AUTHORIZED_USER_IDS=
