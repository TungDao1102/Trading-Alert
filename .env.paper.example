# Trading-Alert PAPER-service environment template (plan 24-36, D-29, WR-06, OPS-02)
#
# Copy to `.env.paper` (or the file named by TRADING_PAPER_ENV_FILE) and fill in real values.
# `.env.paper` is ignored by version control and must stay mode 0600. Never commit a value, never
# paste one into a chat, a log or a shell history, never read it back into a transcript
# (src/ops/redaction.py).
#
# This file is read ONLY by the `paper` and `paper-pin` compose services, on top of the shared
# `.env` (database values). The always-on collector, db-upgrade, backup, ops and live services do
# not read it, so the SHADOW bot token reaches the process that sends SIMULATE messages and no
# other. The live process even refuses to start when TELEGRAM_BOT_TOKEN is present, so these names
# never belong in `.env.live`. Binance names belong to neither file: the paper runtime refuses to
# start when any BINANCE_ name is present (exit code 3), even with an empty value.
#
# The soak (deploy/compose-soak.sh) points TRADING_PAPER_ENV_FILE at its soak env file, so the soak
# needs no file of this kind.

# TELEGRAM_BOT_TOKEN
#   source: Telegram BotFather-issued token (https://t.me/BotFather); the SHADOW bot, not the live
#           bot of `.env.live` (one getUpdates consumer per bot token)
#   shape:  <digits>:<alnum>   (never paste a real one anywhere in the repository)
#   used by: src/adapters/telegram_notify.py (send_simulate), src/paper/runtime.py (_shadow_from_env)
TELEGRAM_BOT_TOKEN=

# TELEGRAM_AUTHORIZED_CHAT_ID
#   source: operator-provisioned allowlisted chat id receiving SIMULATE messages
#   shape:  integer (positive, may be negative for groups)
#   used by: src/paper/notify.py (notify_simulate)
TELEGRAM_AUTHORIZED_CHAT_ID=

# TELEGRAM_AUTHORIZED_USER_IDS
#   source: the Telegram user ids allowed to press APPROVE/SKIP, comma-separated; required when the
#           bot token and the chat id are set (the runtime refuses to start without it)
#   shape:  positive integers, e.g. <id>,<id>   (never paste real ids here)
#   used by: src/paper/runtime.py (_shadow_from_env), src/adapters/telegram_callbacks.py
TELEGRAM_AUTHORIZED_USER_IDS=

# Optional runtime selection (names only; the ratified values are in the soak env template and
# RUNBOOK 20). Leave commented unless the runbook tells you to set them.
# PAPER_RUNTIME_CONFIG=
# PAPER_STRATEGY_ID=
# PAPER_PARAMETER_SET_ID=
