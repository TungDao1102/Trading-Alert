# OMO harness runtime state — machine-local session continuation pointers, never commit
.omo/**/*.json

# Python build/cache artefacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# uv-managed virtualenv
.venv/

# Local data — Parquet raw store + DuckDB scratch live outside git (D-04)
data/
backup/

# Allow source-tree packages named "data" (src/data/...)
!src/data/

# Paper soak runtime state — diff log + pinned state are append-only
# runtime state, not source files (D-04)
logs/

# Test artefacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local env (T-02-02 — credentials must never be in git). Every .env variant is ignored
# (.env.prod, .env.live, .env.backup, ...); only the template is tracked.
.env
.env.*
!.env.example

# Keys and secrets files passed to deploy/bootstrap.sh (--secrets-file, --deploy-key)
*.pem
id_ed25519*
secrets*.env

# Deploy rollback state (13.1-10): recorded commit and image IDs, host-local
.deploy/
