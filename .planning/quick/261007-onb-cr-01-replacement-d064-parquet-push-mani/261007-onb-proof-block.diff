+def _stats_names(server: str) -> dict[str, tuple[float, float, str, str]]:
+    import re
+
+    proc = docker(
+        "stats",
+        "--no-stream",
+        "--format",
+        "{{.Name}}|{{.CPUPerc}}|{{.MemUsage}}|{{.NetIO}}|{{.BlockIO}}",
+        check=False,
+        timeout=120,
+    )
+    rows: dict[str, tuple[float, float, str, str]] = {}
+    for line in proc.stdout.splitlines():
+        parts = line.split("|")
+        if len(parts) != 5 or parts[0] == server:
+            continue
+        cpu = re.match(r"([\d.]+)%", parts[1])
+        mem = re.match(r"([\d.]+)\s*([KMG]i?B|B)", parts[2])
+        scale = {
+            "B": 1 / 1048576,
+            "KiB": 1 / 1024,
+            "KB": 1 / 1024,
+            "MiB": 1.0,
+            "MB": 1.0,
+            "GiB": 1024.0,
+            "GB": 1024.0,
+        }
+        if cpu and mem:
+            rows[parts[0]] = (
+                float(cpu.group(1)),
+                float(mem.group(1)) * scale[mem.group(2)],
+                parts[3],
+                parts[4],
+            )
+    return rows
+
+
+class _Sampler:
+    """Samples ``docker stats`` once per cycle for containers that start during the block."""
+
+    def __init__(self, server: str) -> None:
+        self.server = server
+        self.peak_cpu = 0.0
+        self.peak_mem = 0.0
+        self.last_net = ""
+        self.last_block = ""
+        self.samples = 0
+        self.known: set[str] = set()
+        self.stop = False
+        self.thread = None
+
+    def _loop(self) -> None:
+        while not self.stop:
+            try:
+                for name, (cpu, mem, net, block) in _stats_names(self.server).items():
+                    if name in self.known:
+                        continue
+                    self.samples += 1
+                    self.peak_cpu = max(self.peak_cpu, cpu)
+                    self.peak_mem = max(self.peak_mem, mem)
+                    self.last_net, self.last_block = net, block
+            except Exception:  # never fail the measurement because of the sampler
+                return
+            time.sleep(1)
+
+    def __enter__(self) -> _Sampler:
+        try:
+            self.known = set(_stats_names(self.server))
+        except Exception:
+            self.known = set()
+        import threading
+
+        self.thread = threading.Thread(target=self._loop, daemon=True)
+        self.thread.start()
+        return self
+
+    def __exit__(self, *exc: object) -> None:
+        self.stop = True
+        if self.thread is not None:
+            self.thread.join(timeout=150)
+
+    def report(self) -> str:
+        if not self.samples:
+            return "not observable"
+        return (
+            f"peak CPU {self.peak_cpu:.1f}%, peak memory {self.peak_mem:.1f} MiB, "
+            f"last NetIO {self.last_net}, last BlockIO {self.last_block}, samples {self.samples}"
+        )
+
