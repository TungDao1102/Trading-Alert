+_DAYS_90_NS = 90 * 86_400 * 1_000_000_000
+_HIVE = "raw/interval=1m/symbol=BTCUSDT/date=2026-09-30/part.parquet"
+_PLAIN_SIZES = {"raw/a.parquet": 1200, "raw/b.parquet": 1300, "raw/c.parquet": 1400, _HIVE: 1500}
+_PLAIN_LETTERS = {"raw/a.parquet": "A", "raw/b.parquet": "B", "raw/c.parquet": "C", _HIVE: "D"}
+_PROOF_TAIL = 3000
+# Harness fix 1 switch: restart the server container after an out-of-band change so that a
+# cached directory listing cannot hide it (decided from the transcript, never from memory).
+_PROOF_RESTART_SERVER_AFTER_OOB = True
+_WHOLE = ["--one-way"]
