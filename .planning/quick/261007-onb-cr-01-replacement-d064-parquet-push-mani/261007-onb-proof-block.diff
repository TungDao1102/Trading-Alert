+        docker("exec", s3_double.server, "rm", "-rf", f"/data/{arena.bucket}", check=False)
+        shutil.rmtree(tmp_path / f"tier{index}", ignore_errors=True)
+    # Growth observations only: no thresholds, no extrapolation.
+    for prev, cur in zip(results, results[1:], strict=False):
+        for op in (
+            "first-upload",
+            "recursive-listing",
+            "whole-cryptcheck-1",
+            "whole-cryptcheck-2",
