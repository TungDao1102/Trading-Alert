+def test_onb_proof_manifest_compensation(s3_double: S3Double, tmp_path: Path) -> None:
+    import random
+
+    proof = _Proof("compensation")
+    arena = _Arena(proof, s3_double, tmp_path, "comp", baseline=False, tree=False)
+    bundle1 = _make_bundle(tmp_path / "s1")
+    bundle2 = _make_bundle(tmp_path / "s2")
+    id1, id2 = remote.snapshot_id(DAY1), remote.snapshot_id(DAY2)
+
+    def publish(bundle: Path, sid: str, name: str) -> RcloneResult:
+        return arena.call(
+            f"publish-{name}-{sid}",
+            ["copyto", str(bundle / name), f"BACKUPS3CRYPT:snapshots/{sid}/{name}", "--immutable"],
+            tail=600,
+        )
+
+    for sid, bundle in ((id1, bundle1), (id2, bundle2)):
+        proof.check(
+            "HARNESS",
+            "h11",
+            publish(bundle, sid, "pg.dump").returncode == 0,
+            "pg.dump upload rc 0",
+            sid,
+        )
+        if sid == id1:
+            proof.check(
+                "HARNESS",
+                "h11",
+                publish(bundle, sid, "manifest.json").returncode == 0,
+                "manifest upload rc 0",
+                sid,
+            )
+    objects_before_manifest = s3_double.objects(arena.bucket)
+    proof.check(
+        "HARNESS",
+        "h11",
+        publish(bundle2, id2, "manifest.json").returncode == 0,
+        "manifest upload rc 0",
+        id2,
+    )
+    objects_with_manifest = s3_double.objects(arena.bucket)
+    new = objects_with_manifest - objects_before_manifest
+    proof.check(
+        "HARNESS",
+        "h12",
+        len(new) == 1,
+        "exactly one new server object after the DAY2 manifest",
+        f"{len(new)}",
+    )
+    manifest_path, manifest_size = "", 0
+    if len(new) == 1:
+        raw_line = next(iter(new))
+        path, size, _ = raw_line.rsplit(" ", 2)
+        manifest_path, manifest_size = path[2:] if path.startswith("./") else path, int(size)
+
+    check = [
+        "cryptcheck",
+        str(bundle2),
+        f"BACKUPS3CRYPT:snapshots/{id2}",
+        "--include",
+        "/manifest.json",
+    ]
+    m1 = arena.call("M1-cryptcheck-intact-manifest", check)
+    proof.check("PRODUCT", "m1", m1.returncode == 0, "rc 0 on the intact manifest", _rc(m1))
+
+    garbage = _file_with(arena, "garbage.bin", random.Random(3).randbytes(manifest_size))
+    put = arena.call(
+        "M2-corrupt-through-raw-s3", ["copyto", str(garbage), f"{arena.raw}/{manifest_path}"]
+    )
+    m2 = arena.call("M2-cryptcheck-corrupt-manifest", check)
+    proof.check("HARNESS", "h13", put.returncode == 0, "raw overwrite rc 0", _rc(put))
+    proof.check("PRODUCT", "m2", m2.returncode != 0, "non-zero on the corrupted manifest", _rc(m2))
+
+    gone = arena.call(
+        "M3-deletefile-manifest", ["deletefile", f"BACKUPS3CRYPT:snapshots/{id2}/manifest.json"]
+    )
+    complete = remote.list_complete_snapshots(arena.runner)
+    listing = arena.call(
+        "M3-lsf-snapshots", ["lsf", "-R", "--files-only", "BACKUPS3CRYPT:snapshots/"]
+    )
+    other = arena.call(
+        "M3-cryptcheck-day1-manifest",
+        [
+            "cryptcheck",
+            str(bundle1),
+            f"BACKUPS3CRYPT:snapshots/{id1}",
+            "--include",
+            "/manifest.json",
+        ],
+    )
+    after = s3_double.objects(arena.bucket)
+    proof.check(
+        "PRODUCT",
+        "m3",
+        gone.returncode == 0
+        and complete == [id1]
+        and f"{id2}/pg.dump" in listing.stdout.splitlines()
+        and other.returncode == 0
+        and len(after) == len(objects_with_manifest) - 1,
+        "deletefile removes only that manifest; DAY2 is not complete; "
+        "DAY2 pg.dump and DAY1 manifest remain",
+        f"{_rc(gone)}, complete {complete}, objects {len(objects_with_manifest)} -> "
+        f"{len(after)}, day1 {_rc(other)}",
+    )
+    missing = arena.call(
+        "M4-deletefile-missing", ["deletefile", f"BACKUPS3CRYPT:snapshots/{id2}/manifest.json"]
+    )
+    proof.obs("m4", f"deletefile of a path that does not exist: {_rc(missing)}")
+    proof.finish()
