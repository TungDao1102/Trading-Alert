+class _Proof:
+    """Collect-then-assert bookkeeping for one proof test."""
+
+    def __init__(self, test: str) -> None:
+        self.test = test
+        self.product_fail: list[str] = []
+        self.harness_fail: list[str] = []
+
+    def check(self, kind: str, label: str, ok: bool, expected: str, actual: str) -> None:
+        status = "PASS" if ok else "FAIL"
+        print(f"LABEL|{self.test}|{label}|{kind}|{status}|expected={expected}|actual={actual}")
+        if not ok and kind == "PRODUCT":
+            self.product_fail.append(label)
+        elif not ok and kind == "HARNESS":
+            self.harness_fail.append(label)
+
+    def obs(self, label: str, text: str) -> None:
+        print(f"OBS|{self.test}|{label}|{text}")
+
+    def finish(self) -> None:
+        print(f"\nPROOF-RESULT {self.test} PRODUCT={self.product_fail} HARNESS={self.harness_fail}")
+        assert not self.product_fail and not self.harness_fail, (
+            f"PRODUCT{self.product_fail} HARNESS{self.harness_fail}"
+        )
+
+
+class _Arena:
+    """A fresh bucket with a crypt remote, a local tree and a printing runner."""
+
+    def __init__(
+        self,
+        proof: _Proof,
+        s3: S3Double,
+        tmp_path: Path,
+        name: str,
+        *,
+        baseline: bool = True,
+        tree: bool = True,
+    ) -> None:
+        self.proof = proof
+        self.s3 = s3
+        self.name = name
+        self.bucket = s3.new_bucket()
+        self.env = s3.env_for(
+            self.bucket, passphrase=secrets.token_hex(8), salt=secrets.token_hex(8)
+        )
+        self.runner = s3.runner(self.env)
+        self.raw = remote.raw_bucket_remote(self.env)
+        base = tmp_path / name
+        self.local = base / "parquet"
+        self.work = base / "work"
+        self.work.mkdir(parents=True)
+        self.local.mkdir(parents=True)
+        self.originals: dict[str, tuple[bytes, int]] = {}
+        self.objmap: dict[str, str] = {}
+        self.objsize: dict[str, int] = {}
+        self.overheads: set[int] = set()
+        self.last_seconds = 0.0
+        if tree:
+            for rel, size in _PLAIN_SIZES.items():
+                self.create(rel, _PLAIN_LETTERS[rel].encode() * size)
+        if tree and baseline:
+            first = self.call(
+                "baseline-copy", ["copy", str(self.local), "BACKUPS3CRYPT:parquet", "--immutable"]
+            )
+            objects = self.map_objects()
+            proof.check(
+                "HARNESS",
+                "h0",
+                first.returncode == 0 and objects and len(self.overheads) == 1,
+                "baseline copy rc 0, four ciphertext objects, one constant overhead",
+                f"rc {first.returncode}, mapped {bool(objects)}, "
+                f"overheads {sorted(self.overheads)}",
+            )
+
+    # -- local tree ------------------------------------------------------------------------ #
+    def path(self, rel: str) -> Path:
+        return self.local / rel
+
+    def create(self, rel: str, data: bytes) -> None:
+        target = self.path(rel)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(data)
+        self.originals[rel] = (data, target.stat().st_mtime_ns)
+
+    def mtime(self, rel: str) -> int:
+        return self.originals[rel][1]
+
+    def overwrite(self, rel: str, data: bytes, mtime_ns: int) -> None:
+        target = self.path(rel)
+        target.write_bytes(data)
+        os.utime(target, ns=(mtime_ns, mtime_ns))
+
+    def reset_local(self) -> None:
+        for rel, (data, mtime_ns) in self.originals.items():
+            self.overwrite(rel, data, mtime_ns)
+
+    # -- printing runner ------------------------------------------------------------------- #
+    def show(self, arg: str) -> str:
+        out = arg
+        for text, label in ((str(self.work), "WORK"), (str(self.local), "LOCAL")):
+            out = out.replace(text, label)
+        return out
+
+    def call(self, label: str, argv: Sequence[str], *, tail: int = _PROOF_TAIL) -> RcloneResult:
+        started = time.perf_counter()
+        result = self.runner(list(argv), {})
+        self.last_seconds = time.perf_counter() - started
+        shown = " ".join(self.show(arg) for arg in argv)
+        print(f"\n##### [{self.proof.test}/{self.name}] {label} :: rclone {shown}")
+        print(f"##### rc={result.returncode} seconds={self.last_seconds:.2f}")
+        print(f"----- stdout (last {tail} chars)\n{result.stdout[-tail:]}")
+        print(f"----- stderr (last {tail} chars)\n{result.stderr[-tail:]}\n#####")
+        return result
+
+    def whole(self, label: str, extra: Sequence[str] = ()) -> RcloneResult:
+        argv = ["cryptcheck", str(self.local), "BACKUPS3CRYPT:parquet", *_WHOLE, *extra]
+        return self.call(label, argv)
+
+    # -- server side objects --------------------------------------------------------------- #
+    def map_objects(self) -> bool:
+        rows: list[tuple[int, str]] = []
+        for line in self.s3.objects(self.bucket):
+            path, size, _ = line.rsplit(" ", 2)
+            rows.append((int(size), path[2:] if path.startswith("./") else path))
+        rows.sort()
+        plains = sorted(_PLAIN_SIZES.items(), key=lambda item: item[1])
+        if len(rows) != len(plains):
+            self.proof.obs("o3", f"unexpected server objects: {rows}")
+            return False
+        self.overheads = {size - plain for (size, _), (_, plain) in zip(rows, plains, strict=True)}
+        for (size, path), (rel, _) in zip(rows, plains, strict=True):
+            self.objmap[rel] = path
+            self.objsize[rel] = size
+        return True
+
+    def server_path(self, rel: str) -> str:
+        return f"/data/{self.bucket}/{self.objmap[rel]}"
+
+    def exec_sh(self, script: str):
+        return docker("exec", self.s3.server, "sh", "-c", script, check=False)
+
+    def server_size(self, rel: str) -> int:
+        out = self.exec_sh(f"stat -c %s {self.server_path(rel)}").stdout.strip()
+        return int(out) if out.isdigit() else -1
+
+    def oob_body(self, rel: str, seed: int) -> int:
+        import base64
+        import random
+
+        body = random.Random(seed).randbytes(self.objsize[rel] - 32)
+        b64 = base64.b64encode(body).decode()
+        script = f"echo {b64} | base64 -d | dd of={self.server_path(rel)} bs=1 seek=32 conv=notrunc"
+        return self.exec_sh(script).returncode
+
+    def oob_whole(self, rel: str, seed: int) -> int:
+        import base64
+        import random
+
+        body = random.Random(seed).randbytes(self.objsize[rel])
+        b64 = base64.b64encode(body).decode()
+        return self.exec_sh(f"echo {b64} | base64 -d > {self.server_path(rel)}").returncode
+
+    def oob_rm(self, rel: str) -> int:
+        return self.exec_sh(f"rm -f {self.server_path(rel)}").returncode
+
+    def restart_server(self) -> None:
+        docker("restart", self.s3.server, timeout=120)
+        address = docker(
+            "inspect", "--format", "{{.NetworkSettings.Networks.bridge.IPAddress}}", self.s3.server
+        ).stdout.strip()
+        self.s3.address = address
+        self.env = {**self.env, "BACKUP_S3_ENDPOINT": f"http://{address}:{S3_PORT}"}
+        self.runner = self.s3.runner(self.env)
+        for _ in range(STARTUP_TRIES):
+            if self.runner(["lsf", self.raw], {}).returncode == 0:
+                return
+            time.sleep(1)
+
+    def raw_listing(self, label: str) -> dict[str, tuple[str, int]]:
+        if _PROOF_RESTART_SERVER_AFTER_OOB and label == "C1-raw-after":
+            self.restart_server()
+        result = self.call(
+            label, ["lsf", "-R", "--files-only", "--format", "hsp", self.raw], tail=1500
+        )
+        listing: dict[str, tuple[str, int]] = {}
+        for line in result.stdout.splitlines():
+            parts = line.split(";", 2)
+            if len(parts) == 3 and parts[1].isdigit():
+                listing[parts[2]] = (parts[0], int(parts[1]))
+        return listing
+
+
+def _file_with(arena: _Arena, name: str, data: bytes) -> Path:
+    target = arena.work / name
+    target.write_bytes(data)
+    return target
+
+
+def _list_file(arena: _Arena, name: str, rels: Sequence[str]) -> Path:
+    target = arena.work / name
+    target.write_bytes("".join(f"{rel}\n" for rel in rels).encode())
+    return target
+
+
+def _rc(result: RcloneResult) -> str:
+    return f"rc {result.returncode}"
+
+
+def _detect_subset(
+    proof: _Proof, s3: S3Double, tmp_path: Path, tag: str, bad: str, good: str
+) -> dict[str, bool]:
+    """One corrupted path (raw S3 PUT of same-length random bytes) and the two subset forms."""
+    import random
+
+    arena = _Arena(proof, s3, tmp_path, f"subset-{tag}")
+    size = arena.objsize[bad]
+    garbage = _file_with(arena, "garbage.bin", random.Random(11).randbytes(size))
+    put = arena.call(
+        f"{tag}-corrupt-through-raw-s3",
+        ["copyto", str(garbage), f"{arena.raw}/{arena.objmap[bad]}"],
+    )
+    full = arena.whole(f"{tag}-whole-control")
+    proof.check(
+        "HARNESS",
+        f"h9-{tag}",
+        put.returncode == 0 and full.returncode != 0,
+        "raw overwrite rc 0 and the whole-tree check fails (one corrupted path exists)",
+        f"{_rc(put)}, whole {_rc(full)}",
+    )
+    base = ["cryptcheck", str(arena.local), "BACKUPS3CRYPT:parquet", "--one-way"]
+    out: dict[str, bool] = {}
+    for form, flag in (("F1", "--files-from-raw"), ("F2", "--include")):
+        for role, rel in (("bad", bad), ("good", good)):
+            if form == "F1":
+                value = str(_list_file(arena, f"{form}-{role}.txt", [rel]))
+            else:
+                value = f"/{rel}"
+            result = arena.call(f"{tag}-{form}-{role}", [*base, flag, value])
+            expect_fail = role == "bad"
+            out[f"{form}-{role}"] = (result.returncode != 0) == expect_fail
+    return out
+
