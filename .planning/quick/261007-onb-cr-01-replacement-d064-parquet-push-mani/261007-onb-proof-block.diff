+def test_onb_proof_cost(
+    s3_double: S3Double, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    import datetime as dt
+    import json
+    import platform
+    import random
+    import shutil
+    import statistics
+    import sys
+
+    this = sys.modules[__name__]
+    original_docker = docker
+
+    def long_docker(*args: str, **kwargs: object):
+        kwargs["timeout"] = max(float(kwargs.get("timeout", 300) or 300), 3600.0)  # type: ignore[arg-type]
+        return original_docker(*args, **kwargs)  # type: ignore[arg-type]
+
+    monkeypatch.setattr(this, "docker", long_docker)
+    proof = _Proof("cost")
+    label = (
+        "double, not real S3 (no network latency, no request cost, Docker Desktop on WSL2, "
+        "bind mounts, one docker run per rclone call)"
+    )
+    print(f"COST|label|{label}")
+    print(
+        f"COST|machine|cpu_count={os.cpu_count()} platform={platform.platform()} "
+        f"docker={original_docker('version', '--format', '{{.Server.Version}}').stdout.strip()} "
+        "docker_ncpu_mem="
+        f"{original_docker('info', '--format', '{{.NCPU}} {{.MemTotal}}').stdout.strip()}"
+    )
+    base_times: list[float] = []
+    for _ in range(3):
+        started = time.perf_counter()
+        original_docker("run", "--rm", RCLONE_IMAGE, "version")
+        base_times.append(time.perf_counter() - started)
+    print(
+        "COST|baseline|median docker run rclone version "
+        f"seconds={statistics.median(base_times):.2f} "
+        f"all={[round(t, 2) for t in base_times]}"
+    )
+
+    results: list[dict[str, float]] = []
+    stopped = False
+    for index, (count, size) in enumerate(_COST_TIERS):
+        tier = f"{count}x{size // 1024}KiB"
+        if stopped:
+            print(f"COST|{tier}|not completed (session)")
+            continue
+        source = tmp_path / f"tier{index}" / "raw"
+        symbols = [f"SYM{n}USDT" for n in range(8)]
+        first_day = dt.date(2026, 1, 1)
+        rels: list[str] = []
+        for n in range(count):
+            day = first_day + dt.timedelta(days=n // 8)
+            rel = f"interval=1m/symbol={symbols[n % 8]}/date={day.isoformat()}/part.parquet"
+            target = source / rel
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(random.Random(index * 1_000_000 + n).randbytes(size))
+            rels.append(f"raw/{rel}")
+        bundle = tmp_path / f"tier{index}" / "bundle"
+        started = time.perf_counter()
+        backup_mod.backup(bundle_root=bundle, pg_dump_runner=_fake_dump, parquet_roots=[source])
+        stage_s = time.perf_counter() - started
+        started = time.perf_counter()
+        problems = backup_mod.verify_bundle(bundle)
+        verify_s = time.perf_counter() - started
+        manifest_bytes = (bundle / "manifest.json").stat().st_size
+        arena = _Arena(proof, s3_double, tmp_path, f"cost{index}", baseline=False, tree=False)
+        arena.local = bundle / "parquet"
+        lst = _list_file(arena, "all.txt", rels)
+        measured: dict[str, float] = {}
+
+        def timed(
+            op: str,
+            argv: Sequence[str],
+            measured: dict[str, float] = measured,
+            arena: _Arena = arena,
+            tier: str = tier,
+        ) -> RcloneResult:
+            result = arena.call(f"{tier}-{op}", argv, tail=400)
+            measured[op] = arena.last_seconds
+            proof.check("HARNESS", f"hc-{tier}-{op}", result.returncode == 0, "rc 0", _rc(result))
+            print(f"COST|{tier}|{op}|seconds={arena.last_seconds:.2f}")
+            return result
+
+        remote_tree = ["BACKUPS3CRYPT:parquet"]
+        timed(
+            "first-upload",
+            ["copy", str(arena.local), *remote_tree, "--files-from-raw", str(lst), "--immutable"],
+        )
+        objects = s3_double.objects(arena.bucket)
+        cipher_bytes = sum(int(line.rsplit(" ", 2)[1]) for line in objects)
+        timed("recursive-listing", ["lsf", "-R", "--files-only", "BACKUPS3CRYPT:parquet/"])
+        sid = remote.snapshot_id(DAY1)
