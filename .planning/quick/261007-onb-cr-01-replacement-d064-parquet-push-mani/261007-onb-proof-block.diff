+        ("s4", s4, "F2 include form leaves the clean path alone (scope control)"),
+    ):
+        proof.check("PRODUCT-ROW", label, ok, what, f"plain/hive {plain}/{hive}")
+    proof.check(
+        "PRODUCT",
+        "s-pair",
+        (s1 and s2) or (s3 and s4),
+        "at least one of (s1,s2) or (s3,s4) holds",
+        f"s1={s1} s2={s2} s3={s3} s4={s4}",
+    )
+    proof.obs("form", f"subset form to use: {'F1' if s1 and s2 else 'F2' if s3 and s4 else 'NONE'}")
+
+    # Mechanics U1 U2 O4 L1 L2 CAT1 on an empty remote
+    arena = _Arena(proof, s3_double, tmp_path, "mech", baseline=False)
+    first = _list_file(arena, "u1.txt", ["raw/a.parquet", _HIVE])
+    up1 = arena.call(
+        "U1-copy-files-from-raw",
+        [
+            "copy",
+            str(arena.local),
+            "BACKUPS3CRYPT:parquet",
+            "--files-from-raw",
