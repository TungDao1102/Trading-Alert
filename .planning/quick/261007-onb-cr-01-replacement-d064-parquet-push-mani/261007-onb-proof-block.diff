+def test_onb_proof_detection(s3_double: S3Double, tmp_path: Path) -> None:
+    proof = _Proof("detection")
+    need_report = False
+
+    # D0 baseline, identical content
+    arena = _Arena(proof, s3_double, tmp_path, "d0")
+    result = arena.whole("D0-whole")
+    proof.check("PRODUCT", "d1", result.returncode == 0, "rc 0 on identical content", _rc(result))
+    proof.obs("o3", f"ciphertext overhead per object (bytes): {sorted(arena.overheads)}")
+    arena.call(
+        "D0-lsf-pe", ["lsf", "-R", "--files-only", "--format", "pe", "BACKUPS3CRYPT:parquet"]
+    )
+    proof.obs("o3", f"ciphertext objects by size rank: {arena.objmap}")
+
+    # A1 same size, different content, ORIGINAL mtime
+    arena = _Arena(proof, s3_double, tmp_path, "a1")
+    rel = "raw/a.parquet"
+    arena.overwrite(rel, b"X" * 1200, arena.mtime(rel))
+    args = [str(arena.local), "BACKUPS3CRYPT:parquet"]
+    ctl1 = arena.call("A1-control-check-size-only", ["check", "--size-only", "--one-way", *args])
+    proof.check(
+        "HARNESS",
+        "h1",
+        ctl1.returncode == 0,
+        "size-only check passes on a same-size change",
+        _rc(ctl1),
+    )
+    ctl2 = arena.call(
+        "A1-control-copy-immutable-size-only", ["copy", *args, "--immutable", "--size-only"]
+    )
+    ctl3 = arena.call("A1-control-cat-remote-a", ["cat", "BACKUPS3CRYPT:parquet/raw/a.parquet"])
+    proof.check(
+        "HARNESS",
+        "h2",
+        ctl2.returncode == 0 and ctl3.stdout == "A" * 1200,
+        "old size-only push exits 0 and the remote still holds the old bytes",
+        f"{_rc(ctl2)}, remote a is old bytes: {ctl3.stdout == 'A' * 1200}",
+    )
+    result = arena.whole("A1-whole")
+    proof.check(
+        "PRODUCT", "a1", result.returncode != 0, "non-zero on same size, same mtime", _rc(result)
+    )
+    named_default = rel in result.stdout + result.stderr
+    proof.obs("p1", f"default output names the differing path: {named_default}")
+    for flag in ("--combined", "--differ", "--missing-on-dst", "--error"):
+        report = arena.whole(f"A1-whole-report{flag}", [flag, "-"])
+        proof.obs("p1", f"{flag} -: {_rc(report)}, names path: {rel in report.stdout}")
+    need_report = not named_default
+    if need_report:
+        final = arena.whole("A1-whole-final-argv", ["--combined", "-"])
+        proof.check(
+            "PRODUCT", "a1f", final.returncode != 0, "non-zero with report flag", _rc(final)
+        )
+    arena.reset_local()
+    result = arena.whole("A1-whole-after-reset")
+    proof.check(
+        "HARNESS", "h5", result.returncode == 0, "reset local tree passes again", _rc(result)
+    )
+
+    # A2 same size, different content, NEW mtime
+    arena = _Arena(proof, s3_double, tmp_path, "a2")
+    arena.overwrite(rel, b"Y" * 1200, arena.mtime(rel) + _DAYS_90_NS)
+    result = arena.whole("A2-whole")
+    proof.check(
+        "PRODUCT", "a2", result.returncode != 0, "non-zero on same size, new mtime", _rc(result)
+    )
+
+    # A3 different size
+    arena = _Arena(proof, s3_double, tmp_path, "a3")
+    arena.overwrite(rel, b"Y" * 1300, arena.mtime(rel))
+    result = arena.whole("A3-whole")
+    proof.check(
+        "PRODUCT", "a3", result.returncode != 0, "non-zero on a different size", _rc(result)
+    )
+
+    # A4 mtime only
+    arena = _Arena(proof, s3_double, tmp_path, "a4")
+    for name in arena.originals:
+        later = arena.mtime(name) + _DAYS_90_NS
+        os.utime(arena.path(name), ns=(later, later))
+    result = arena.whole("A4-whole")
+    proof.check(
+        "PRODUCT", "d2", result.returncode == 0, "rc 0 after an mtime-only change", _rc(result)
+    )
+
+    # B1 / B2 out of band through the server container
+    for label, mode in (("b1", "body"), ("b2", "whole")):
+        arena = _Arena(proof, s3_double, tmp_path, label)
+        before = arena.raw_listing(f"{label.upper()}-raw-before")
+        path = arena.objmap[rel]
+        exec_rc = arena.oob_body(rel, 1) if mode == "body" else arena.oob_whole(rel, 2)
+        after = arena.raw_listing(f"{label.upper()}-raw-after")
+        same_size = after.get(path, ("", -1))[1] == before[path][1]
+        changed = after.get(path, ("", -1))[0] != before[path][0]
+        visible = exec_rc == 0 and path in after and same_size and changed
+        proof.check(
+            "HARNESS",
+            "h3",
+            visible,
+            "the server shows the same size and a different hash after the out-of-band write",
+            f"exec rc {exec_rc}, listed {path in after}, same size {same_size}, "
+            f"hash changed {changed}",
+        )
+        result = arena.whole(f"{label.upper()}-whole")
+        if visible:
+            proof.check("PRODUCT", label, result.returncode != 0, f"non-zero ({mode})", _rc(result))
+        else:
+            proof.obs(label, f"HARNESS LIMIT (h3 unsatisfied): whole {_rc(result)}")
+
+    # B3 overwritten through the crypt remote itself (no --immutable)
+    arena = _Arena(proof, s3_double, tmp_path, "b3")
+    other = _file_with(arena, "other-a.bin", b"Z" * 1200)
+    put = arena.call(
+        "B3-copyto-through-crypt", ["copyto", str(other), "BACKUPS3CRYPT:parquet/raw/a.parquet"]
+    )
+    result = arena.whole("B3-whole")
+    proof.check("HARNESS", "h6", put.returncode == 0, "overwrite through crypt rc 0", _rc(put))
+    proof.check(
+        "PRODUCT", "b3", result.returncode != 0, "non-zero after crypt overwrite", _rc(result)
+    )
+
+    # B4 overwritten through the raw S3 remote
+    arena = _Arena(proof, s3_double, tmp_path, "b4")
+    import random
+
+    before = arena.raw_listing("B4-raw-before")
+    path = arena.objmap[rel]
+    garbage = _file_with(arena, "garbage.bin", random.Random(5).randbytes(arena.objsize[rel]))
+    put = arena.call("B4-copyto-through-raw-s3", ["copyto", str(garbage), f"{arena.raw}/{path}"])
+    after = arena.raw_listing("B4-raw-after")
+    seen = (
+        after.get(path, ("", -1))[1] == before[path][1]
+        and after.get(path, ("", -1))[0] != before[path][0]
+    )
+    proof.check(
+        "HARNESS",
+        "h7",
+        put.returncode == 0 and seen,
+        "raw overwrite rc 0, same size, hash changed",
+        f"{_rc(put)}, seen {seen}",
+    )
+    result = arena.whole("B4-whole")
+    proof.check(
+        "PRODUCT", "b4", result.returncode != 0, "non-zero after raw S3 overwrite", _rc(result)
+    )
+
+    # C1 removed out of band
+    arena = _Arena(proof, s3_double, tmp_path, "c1")
+    rel_b = "raw/b.parquet"
+    arena.raw_listing("C1-raw-before")
+    exec_rc = arena.oob_rm(rel_b)
+    after = arena.raw_listing("C1-raw-after")
+    visible = exec_rc == 0 and arena.objmap[rel_b] not in after
+    proof.check(
+        "HARNESS",
+        "h3",
+        visible,
+        "the server no longer lists the removed object",
+        f"exec rc {exec_rc}, still listed {arena.objmap[rel_b] in after}",
+    )
+    result = arena.whole("C1-whole")
+    if visible:
+        proof.check(
+            "PRODUCT",
+            "c1",
+            result.returncode != 0,
+            "non-zero after out-of-band removal",
+            _rc(result),
+        )
+    else:
+        proof.obs("c1", f"HARNESS LIMIT (h3 unsatisfied): whole {_rc(result)}")
+
+    # C2 removed through the product path
+    arena = _Arena(proof, s3_double, tmp_path, "c2")
+    gone = arena.call("C2-deletefile", ["deletefile", "BACKUPS3CRYPT:parquet/raw/b.parquet"])
+    result = arena.whole("C2-whole")
+    proof.check("HARNESS", "h8", gone.returncode == 0, "deletefile rc 0", _rc(gone))
+    proof.check("PRODUCT", "c2", result.returncode != 0, "non-zero after deletefile", _rc(result))
+    if need_report:
+        final = arena.whole("C2-whole-final-argv", ["--combined", "-"])
+        proof.check(
+            "PRODUCT", "c2f", final.returncode != 0, "non-zero with report flag", _rc(final)
+        )
+
+    # X1 remote-only extra object
+    arena = _Arena(proof, s3_double, tmp_path, "x1")
+    extra = _file_with(arena, "z.parquet", b"Q" * 1100)
+    put = arena.call(
+        "X1-remote-only-z", ["copyto", str(extra), "BACKUPS3CRYPT:parquet/raw/z.parquet"]
+    )
+    result = arena.whole("X1-whole")
+    proof.check("HARNESS", "h10", put.returncode == 0, "remote-only upload rc 0", _rc(put))
+    proof.check(
+        "PRODUCT", "e1", result.returncode == 0, "rc 0 with a remote-only extra file", _rc(result)
+    )
+    two_way = arena.call(
+        "X1-whole-without-one-way", ["cryptcheck", str(arena.local), "BACKUPS3CRYPT:parquet"]
+    )
+    proof.obs("o1", f"without --one-way: {_rc(two_way)}")
+
+    # Subset forms, plain and hive path, each in a bucket with one corrupted path
+    plain = _detect_subset(proof, s3_double, tmp_path, "plain", "raw/a.parquet", "raw/c.parquet")
+    hive = _detect_subset(proof, s3_double, tmp_path, "hive", _HIVE, "raw/c.parquet")
+    s1 = plain["F1-bad"] and hive["F1-bad"]
+    s2 = plain["F1-good"] and hive["F1-good"]
+    s3 = plain["F2-bad"] and hive["F2-bad"]
+    s4 = plain["F2-good"] and hive["F2-good"]
+    for label, ok, what in (
