# Evidence remote environment template (plan 16-47, decision O-01 option a): names only, never a value.
#
# Use: copy to a file outside the checkout (mode 0600) and fill it on the soak host, then load it
# only into the shell that runs scripts/export_soak_evidence.py --publish, for example
#   set -a; . /path/to/evidence.env; set +a
# The real file is never committed and never printed. It is NOT the soak environment file
# (deploy/soak.env.example): that file is shared with the paper container, which must not hold
# this credential. The paper runtime reads none of these names (ALLOWED_ENV_NAMES).
#
# Separate from the backup chain: these names are not the BACKUP_ names, the remote is the plain
# S3 remote EVIDENCES3 and there is no crypt layer. Use a bucket credential of its own, scoped to
# this bucket and prefix; the exporter refuses to start when it equals the backup credential.
# A change of provider changes values only.

# AWS, Wasabi, or Other (Other = any S3-compatible store; then set EVIDENCE_S3_ENDPOINT).
EVIDENCE_S3_PROVIDER=
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_REGION=
EVIDENCE_S3_BUCKET=
# Required, never empty: the epoch directories are written under <bucket>/<prefix>/.
# Letters, digits, dot, underscore, hyphen and "/" between non-empty segments.
EVIDENCE_S3_PREFIX=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
# Optional, needed only for `scripts/export_soak_evidence.py --host-witness` (16-DEC-HOST-TICK).
# It names the fixed witness prefix the host timer writes its create-only tick objects to (plan B,
# RUNBOOK 20.10). It must be a SIBLING of EVIDENCE_S3_PREFIX: never equal to it, inside it or
# containing it. This credential only reads it; the host's create-only credential is never this
# one.
EVIDENCE_S3_WITNESS_PREFIX=
