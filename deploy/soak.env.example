# Soak environment template (plan 16-32, D-32): variable names only, never a value.
#
# Use: copy to a file outside the checkout (mode 0600), fill the values on the soak host from
# the off-host secrets file, and select it for the soak project with
#   TRADING_ENV_FILE=/path/to/soak.env deploy/compose-soak.sh ...
# The real file is never committed and never printed (a resolved compose config holds secrets).
#
# Trade-capable keys: this template lists no exchange credential, and none belongs in the soak
# file. The paper runtime refuses to start when any variable whose name begins with BINANCE and
# an underscore is present in its environment, even with an empty value (exit code 3).
#
# Shared env_file (WR-06): every x-app service of docker-compose.yml shares one env_file, so the
# paper container also sees the BACKUP_ variables below until the per-service split of Phase 24.
# The paper runtime reads only the names in ALLOWED_ENV_NAMES (src/paper/runtime_config.py) and
# never logs a value.
#
# Read by: paper runtime and collector (database and runtime names), backup service (BACKUP_
# names), compose interpolation (IMAGE_TAG).

# --- PostgreSQL (the soak project has its own pgdata volume, project trading-soak) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=
DATABASE_URL_SYNC=

# --- Paper runtime ---
# PAPER_RUNTIME_CONFIG names the ratified configuration inside the image (plan 16-55): the
# image carries config/paper/, so the path is /app/config/paper/paper-runtime-v2.toml, the
# configuration in force since plan 16-56 (deploy/soak-image.sh checks it in the built image
# before it records the build; v1 is the historical version and no longer loads).
PAPER_RUNTIME_CONFIG=
PAPER_STRATEGY_ID=
PAPER_PARAMETER_SET_ID=

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_CHAT_ID=

# --- Off-host backup (backup service) ---
# The soak project backs up into its own bucket (plan 16-55): BACKUP_S3_BUCKET here must be a
# bucket that trading-backup (the checkout's .env) never uses, with its own crypt passwords,
# initialised once with deploy/backup.sh --init-remote for this project. The backup remote has
# no project in its paths, so a shared bucket would mix both projects' snapshots and retention
# would delete one of them every day. deploy/backup.sh --install-soak-timer refuses an empty
# bucket or the trading bucket.
# BACKUP_REMOTE: empty (or s3) is the default off-host remote of the BACKUP_S3_ names below; a
# missing one fails closed. none is the explicit local-only opt-in (RUNBOOK 11, Local-only mode):
# the backup and the drill run without any remote, exit 0, print the warning "OFF-HOST COPY
# SKIPPED: this backup does not survive the loss of this host" and OFFSITE_COPY=skipped, and
# --install-soak-timer then needs no bucket. A local-only backup never satisfies the soak pin.
BACKUP_REMOTE=
BACKUP_S3_PROVIDER=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_PASSWORD2=

# --- Image selection (compose) ---
IMAGE_TAG=
