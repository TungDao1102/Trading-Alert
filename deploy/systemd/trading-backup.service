# Nightly encrypted off-host backup (13.1-10, D-12). Installed by `deploy/backup.sh --install-timer`,
# which substitutes the checkout directory for the directory token below. The wrapper exits with the exit code of
# `python -m src.ops.backup scheduled`, so a failed backup makes this oneshot unit fail visibly
# (`systemctl status trading-backup`, `journalctl -u trading-backup`). User must be the operator
# account that is in the docker group (deploy/bootstrap.sh creates `trading`).
[Unit]
Description=Trading stack: scheduled encrypted off-host backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=trading
WorkingDirectory=@TRADING_DIR@
ExecStart=/usr/bin/env bash @TRADING_DIR@/deploy/backup.sh
TimeoutStartSec=2h
