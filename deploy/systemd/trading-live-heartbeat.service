# Separate external heartbeat ping for the LIVE runtime (plan 24-24, D-30, R-8, inherited item
# 16-50; owner answer 24-01 Q11: one external check per process). Installed by
# `deploy/heartbeat.sh --target live --install-timer --interval-seconds N`, which substitutes the
# checkout directory, the live URL file path and the fail-ping flag for the tokens below.
# One run executes the read-only liveness probe of the live service of the main stack
# (`python -m src.live.runtime --liveness`) and pings the live check of the external monitor only
# while it passes: a held refusal or a stale liveness stamp sends no success ping.
# It never stops, restarts or otherwise touches the live runtime; a failed ping only fails this
# oneshot unit (`systemctl status trading-live-heartbeat`).
# The live ping URL is a secret of its own, never the collector's or the paper's: it lives in a
# root-only file, and systemd hands this unit a private copy of it as the credential
# `heartbeat-live-url`.
# There is deliberately no dependency, restart or failure link to any other unit. User must be the
# operator account that is in the docker group (deploy/bootstrap.sh creates `trading`).
[Unit]
Description=Trading stack: external heartbeat ping for the live runtime
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=trading
WorkingDirectory=@TRADING_DIR@
LoadCredential=heartbeat-live-url:@URL_FILE@
Environment=HEARTBEAT_FAIL_PING=@FAIL_PING@
ExecStart=/usr/bin/env bash @TRADING_DIR@/deploy/heartbeat.sh --target live
