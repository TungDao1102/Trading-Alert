# Nightly encrypted off-host backup of the SOAK project (plan 16-55, review B2-WR-07). Installed by
# `deploy/backup.sh --install-soak-timer --soak-env-file <path>`, which substitutes the checkout
# directory and the soak env file for the two tokens below. It is the trading-backup.service pair
# with the soak project selected: COMPOSE_PROJECT_NAME picks the trading-soak project (its own
# pgdata volume, where the soak evidence lives) and TRADING_ENV_FILE picks the soak env file, whose
# BACKUP_S3_BUCKET must be a bucket of its own, never the one trading-backup uses (the remote
# layout has no project component, so two projects in one bucket would share one snapshot series
# and retention would delete one project's daily dump; evidence/16-55-recheck.md).
[Unit]
Description=Trading soak project: scheduled encrypted off-host backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=trading
WorkingDirectory=@TRADING_DIR@
Environment=COMPOSE_PROJECT_NAME=trading-soak
Environment=TRADING_ENV_FILE=@SOAK_ENV_FILE@
ExecStart=/usr/bin/env bash @TRADING_DIR@/deploy/backup.sh
TimeoutStartSec=2h
